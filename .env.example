# Uncomment and configure an existing PostgreSQL database for full functionality.
# DATABASE_URL=postgresql://edulink:password@localhost:5432/edulink
PORT=8000
NODE_ENV=development

# Registration and password reset email delivery (optional for demo login).
RESEND_API_KEY=
EMAIL_FROM=
ALLOW_DEV_OTP=false

# Optional WebRTC relay.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Local Mailpit: http://127.0.0.1:8025 (SMTP 127.0.0.1:1025)
# MAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# EMAIL_FROM=EduLink <noreply@edulink.local>
# SMTP_USER=
# SMTP_PASSWORD=
